<user-mapping>
    <authorize username="lab" password="lab">
        <connection name="Lab SSH server">
            <protocol>ssh</protocol>
            <param name="hostname">127.0.0.1</param>
            <param name="port">2222</param>
            <param name="username">test</param>
            <param name="password">test</param>
        </connection>
        <connection name="Second connection (same server)">
            <protocol>ssh</protocol>
            <param name="hostname">127.0.0.1</param>
            <param name="port">2222</param>
            <param name="username">test</param>
            <param name="password">test</param>
        </connection>
        <connection name="Error: wrong password">
            <protocol>ssh</protocol>
            <param name="hostname">127.0.0.1</param>
            <param name="port">2222</param>
            <param name="username">test</param>
            <param name="password">wrong</param>
        </connection>
        <connection name="Error: server unreachable">
            <protocol>ssh</protocol>
            <param name="hostname">127.0.0.1</param>
            <param name="port">1</param>
            <param name="username">test</param>
            <param name="password">test</param>
        </connection>
        <connection name="Error: unknown host">
            <protocol>rdp</protocol>
            <param name="hostname">no-such-host.invalid</param>
            <param name="port">3389</param>
        </connection>
    </authorize>
</user-mapping>
